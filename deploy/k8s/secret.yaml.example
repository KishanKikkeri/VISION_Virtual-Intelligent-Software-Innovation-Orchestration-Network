# deploy/k8s/secret.yaml.example
# ================================
# TEMPLATE ONLY — rename to secret.yaml and fill in real base64-encoded
# values (or, better, manage this Secret via your secrets manager /
# External Secrets Operator instead of committing it at all). Every
# value below is the literal string "REPLACE_ME" base64-encoded, not a
# working credential.
apiVersion: v1
kind: Secret
metadata:
  name: aasc-platform-secrets
type: Opaque
data:
  DATABASE_URL: UkVQTEFDRV9NRQ==
  REDIS_URL: UkVQTEFDRV9NRQ==
  NATS_URL: UkVQTEFDRV9NRQ==
  SECRET_KEY: UkVQTEFDRV9NRQ==
---
apiVersion: v1
kind: Secret
metadata:
  name: aasc-platform-tls
type: kubernetes.io/tls
data:
  tls.crt: UkVQTEFDRV9NRQ==
  tls.key: UkVQTEFDRV9NRQ==
